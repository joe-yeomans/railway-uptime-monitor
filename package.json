{
  "name": "railway-uptime-monitor",
  "version": "0.1.0",
  "description": "Railway-specific uptime monitor with private-network HTTP checks and notifier integrations.",
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "start": "bun run src/main.ts",
    "migrate": "bun run src/main.ts --migrate-only",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run typecheck && bun run lint && bun run format:check"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@graphql-codegen/cli": "^6.1.1",
    "@graphql-codegen/client-preset": "^5.2.2",
    "bun-types": "^1.3.9",
    "dotenv": "^17.2.4",
    "drizzle-kit": "^0.31.9",
    "graphql": "^16.12.0",
    "typescript": "^5.9.3"
  },
  "module": "index.ts",
  "private": true,
  "dependencies": {
    "drizzle-orm": "^0.45.1"
  }
}
