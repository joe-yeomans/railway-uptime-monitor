# Required Railway settings
RAILWAY_API_TOKEN=ra_...
RAILWAY_PROJECT_ID=...
RAILWAY_ENVIRONMENT_ID=...

# Monitor behavior
DATABASE_PATH=./data/monitor.db
PORT=8080
HEALTHCHECK_PATH=/healthz
DISCOVERY_INTERVAL_SECONDS=120
CHECK_INTERVAL_SECONDS=30
CHECK_TIMEOUT_MS=5000
FAILURE_THRESHOLD=3
RECOVERY_THRESHOLD=2
EXPECTED_STATUS_MIN=200
EXPECTED_STATUS_MAX=299
# private|public|auto (default: public in dev, private in production)
TARGET_DOMAIN_MODE=auto

# Optional service filters (comma separated service names)
SERVICE_INCLUDE_LIST=
SERVICE_EXCLUDE_LIST=

# Optional notifier integrations
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
